// Built-in catppuccin-latte, plus an explicit frame_unselected block: the
// stock theme has none, so unfocused pane borders fall back to a faint grey
// that is nearly invisible on the light background. Defined below.
theme "catppuccin-latte-frames"
default_shell "bash"
pane_frames true
default_layout "dev"
mouse_mode true
scroll_buffer_size 10000
copy_on_select true

// Env for every pane Zellij spawns. macOS only exports LC_CTYPE=UTF-8, and
// bash 5.x then warns "setlocale: LC_COLLATE: cannot change locale ()" on
// every prompt. The Zellij server is long-lived and keeps whatever env it was
// started with, so set a full locale here rather than relying on the shell.
env {
    LANG "en_US.UTF-8"
}

keybinds clear-defaults=true {
    normal {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Alt n" { NewPane; }
        bind "Alt t" { NewTab; }
        bind "Alt x" { CloseFocus; }
        bind "Alt q" { Quit; }
        // Pure pane movement — stays within the current tab, never
        // switches tabs, so it can't disturb what's focused elsewhere.
        bind "Alt h" "Alt Left" { MoveFocus "Left"; }
        bind "Alt l" "Alt Right" { MoveFocus "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        // Dedicated tab switching — Zellij restores whichever pane was
        // last focused in that tab, since this never touches pane focus
        // the way MoveFocusOrTab's edge-crossing does.
        bind "Alt Shift Left" "Alt Shift H" { GoToPreviousTab; }
        bind "Alt Shift Right" "Alt Shift L" { GoToNextTab; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
    }
     locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
}

themes {
    catppuccin-latte-frames {
        text_unselected {
            base 76 79 105
            background 220 224 232
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 64 160 43
            emphasis_3 210 15 57
        }
        text_selected {
            base 76 79 105
            background 172 176 190
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 64 160 43
            emphasis_3 234 118 203
        }
        ribbon_selected {
            base 220 224 232
            background 64 160 43
            emphasis_0 210 15 57
            emphasis_1 254 100 11
            emphasis_2 234 118 203
            emphasis_3 30 102 245
        }
        ribbon_unselected {
            base 220 224 232
            background 92 95 119
            emphasis_0 234 118 203
            emphasis_1 76 79 105
            emphasis_2 30 102 245
            emphasis_3 234 118 203
        }
        table_title {
            base 64 160 43
            background 0
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 64 160 43
            emphasis_3 234 118 203
        }
        table_cell_selected {
            base 76 79 105
            background 172 176 190
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 64 160 43
            emphasis_3 234 118 203
        }
        table_cell_unselected {
            base 76 79 105
            background 220 224 232
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 64 160 43
            emphasis_3 234 118 203
        }
        list_selected {
            base 76 79 105
            background 172 176 190
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 64 160 43
            emphasis_3 234 118 203
        }
        list_unselected {
            base 76 79 105
            background 220 224 232
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 64 160 43
            emphasis_3 234 118 203
        }
        // Focused pane border: Catppuccin green (unchanged from stock).
        frame_selected {
            base 64 160 43
            background 0
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 234 118 203
            emphasis_3 0
        }
        frame_highlight {
            base 254 100 11
            background 0
            emphasis_0 210 15 57
            emphasis_1 136 57 239
            emphasis_2 254 100 11
            emphasis_3 254 100 11
        }
        // Unfocused pane border: Catppuccin Latte "Text" (#4c4f69), dark
        // enough to read clearly against the #eff1f5 background.
        frame_unselected {
            base 76 79 105
            background 0
            emphasis_0 254 100 11
            emphasis_1 4 165 229
            emphasis_2 234 118 203
            emphasis_3 0
        }
        exit_code_success {
            base 64 160 43
            background 0
            emphasis_0 4 165 229
            emphasis_1 220 224 232
            emphasis_2 234 118 203
            emphasis_3 30 102 245
        }
        exit_code_error {
            base 210 15 57
            background 0
            emphasis_0 223 142 29
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 234 118 203
            player_2 30 102 245
            player_3 0
            player_4 223 142 29
            player_5 4 165 229
            player_6 0
            player_7 210 15 57
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
