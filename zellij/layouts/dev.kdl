layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // Tab 1: files — yazi file manager
    tab name="files" {
        pane command="bash" {
            args "-ic" "y"
        }
    }

    // Tab 2: editor — just Helix, no console (see the `console` tab).
    tab name="editor" focus=true {
        pane command="hx" {
            args "."
        }
    }

    // Tab 3: console — scratch shell for builds/commands, pulled out of
    // the editor tab so Helix gets the full pane.
    tab name="console" {
        pane name="console"
    }

    // Tab 4: LLM assistant CLI
    tab name="llms" {
    pane command="bash" {
        args "-c" "~/.local/bin/llm"
      }
   }

    // Tab 5: lazygit — status/diff/stage/commit/push without leaving the session
    tab name="git" {
        pane command="lazygit"
    }
}
