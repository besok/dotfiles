layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // Tab 1: files — yazi file manager
    tab name="files" {
        pane command="bash" {
            args "-ic" "y"
        }
    }

    // Tab 2: editor — just Helix, no console.
    tab name="editor" focus=true {
        pane command="hx" {
            args "."
        }
    }

    // Tab 3: ops — four consoles, all manual, no auto-watch.
    // Top-left: single test, e.g. `rt` (fzf-pick + cargo nextest run).
    // Top-right: run, e.g. `cr` (cargo run).
    // Bottom-left: full test suite (cargo nextest run / cargo test).
    // Bottom-right: clippy (cargo clippy).
    tab name="ops" {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="single-test"
                pane name="run"
            }
            pane split_direction="vertical" {
                pane name="all-tests"
                pane name="clippy"
            }
        }
    }

    // Tab 4: LLM assistant CLI
    tab name="llms" {
    pane command="bash" {
        args "-c" "opencode; ~/.config/alacritty/notify-bell.sh"
      }
   }

    // Tab 5: lazygit — status/diff/stage/commit/push without leaving the session
    tab name="git" {
        pane command="lazygit"
    }
}
