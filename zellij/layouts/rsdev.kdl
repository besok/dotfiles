layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // Tab 1: editor on top, two shells side-by-side underneath.
    // Left shell: build/watch (e.g. cargo watch -x run)
    // Right shell: free — use it however you like.
    tab name="editor" focus=true {
        pane split_direction="horizontal" {
            pane command="hx" size="75%" {
                args "."
            }
            pane split_direction="vertical" size="25%" {
                pane name="build/watch"
                pane name="scratch"
            }
        }
    }

    // Tab 2: LLM assistant CLI
    tab name="llms" {
    pane command="bash" {
        args "-c" "opencode; ~/.config/alacritty/notify-bell.sh"
      }
   }

    // Tab 3: lazygit — status/diff/stage/commit/push without leaving the session
    tab name="git" {
        pane command="lazygit"
    }

    // Tab 4: checks — all manual, no auto-watch.
    // Top (60%): run a single test, e.g. via `rt` (fzf-pick + cargo nextest run).
    // Bottom-left: full test suite, run manually (cargo nextest run / cargo test).
    // Bottom-right: clippy, run manually (cargo clippy).
    tab name="checks" {
        pane split_direction="horizontal" {
            pane size="60%" name="single-test"
            pane split_direction="vertical" size="40%" {
                pane name="all-tests"
                pane name="clippy"
            }
        }
    }
}
