// Zed user settings — symlinked to ~/.config/zed/settings.json by install.sh.
// Reference: https://zed.dev/docs/configuring-zed ; `zed: open default settings`
// in the command palette shows every default this file overrides.
{
  // ---- Look & feel: light One theme, same font as Alacritty/Helix -------
  "edit_predictions": {
    "provider": "none"
  },
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "cursor_blink": false,
  "relative_line_numbers": "disabled",
  "wrap_guides": [100],
  "show_wrap_guides": true,
  "preferred_line_length": 100,
  "soft_wrap": "none",
  "indent_guides": { "enabled": true },
  "show_whitespaces": "selection",
  "tab_size": 4,
  "tabs": { "file_icons": true, "git_status": true },
  "toolbar": { "breadcrumbs": true },
  // "comfortable" is the default; switch to { "custom": 1.4 } to tighten/loosen.
  "buffer_line_height": "comfortable",
  // Diff, diagnostic, cursor and search markers in the scrollbar gutter.
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "diagnostics": "all",
    "cursors": true,
    "search_results": true
  },
  // IntelliJ-style: error/warning text rendered at the end of the line.
  "diagnostics": { "inline": { "enabled": true } },
  "hover_popover_enabled": true,
  "hover_popover_delay": 300,

  // ---- IntelliJ-style workflow ------------------------------------------
  // JetBrains keybindings (Ctrl/Cmd-S, Shift-Shift search, etc.).
  "base_keymap": "JetBrains",
  // Alternative: modal editing with Helix keys (built on Zed's vim mode).
  // Flip this on and Zed behaves like hx for movement/selection while the
  // JetBrains bindings above still cover IDE actions (search, run, debug).
  // Still incomplete as of 2026: select-mode, some multi-cursor commands and
  // a few `g`/`space` menus differ from real hx. Left off until it matures.
  // "helix_mode": true,
  // Save like IntelliJ: continuously while typing (0.5s after the last
  // keystroke) *and* whenever the editor loses focus — no explicit save
  // needed. Autosave does not trigger formatters; only an explicit Cmd-S
  // runs format_on_save below.
  "autosave": { "after_delay": { "milliseconds": 500 } },
  "restore_on_startup": "last_session",
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  // JetBrains-like bracket handling: auto-insert the closing pair and let
  // typing the closer skip over it even after moving the cursor.
  "use_autoclose": true,
  "always_treat_brackets_as_autoclosed": true,
  // Double-click a hit in project search / diagnostics to open the real file.
  "double_click_in_multibuffer": "open",
  // Default toggles for the search bar.
  "search": {
    "case_sensitive": false,
    "whole_word": false,
    "regex": false,
    "include_ignored": false
  },

  // ---- Project indexing -------------------------------------------------
  // Setting this REPLACES Zed's defaults, so the VCS/OS entries are repeated
  // here. Build and cache dirs are excluded from search, the project panel and
  // the file finder (rust target/, python venvs, zig caches, node_modules).
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/target",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.pytest_cache",
    "**/zig-out",
    "**/.zig-cache",
    "**/node_modules"
  ],

  // ---- LSP / language tooling ---------------------------------------------
  // Python here differs from helix/languages.toml on purpose: Helix keeps
  // pylsp, Zed runs basedpyright so it behaves like PyCharm (see below).
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" }
      }
    },
    // basedpyright = the PyCharm-like engine: it is Zed's default Python
    // server (downloaded by Zed itself, no install.sh step) and covers what
    // PyCharm's own indexer gives you: go to definition/declaration/type
    // definition, find usages, rename, auto-import completions, inlay hints,
    // call/type hierarchy and type checking. Zed hands it the interpreter of
    // the .venv it detects in the project (toolchain picker in the status
    // bar), so third-party imports resolve like with a configured PyCharm SDK.
    // Anything set in a project's pyproject.toml [tool.basedpyright] or
    // pyrightconfig.json overrides these defaults.
    "basedpyright": {
      "settings": {
        // Import sorting is ruff's job (see formatter below).
        "basedpyright": {
          "disableOrganizeImports": true,
          "analysis": {
            // "standard" ~ PyCharm's default inspection level. basedpyright's
            // own default "recommended" flags far more (reportAny, unused call
            // results, ...); "strict" is mypy --strict territory.
            "typeCheckingMode": "standard",
            // Only open files are analysed, like PyCharm's editor inspections.
            // "workspace" also fills the Diagnostics panel for the whole
            // project (Cmd-6 style) at the cost of an up-front full analysis.
            "diagnosticMode": "openFilesOnly",
            // PyCharm-style completion: offer symbols not yet imported and add
            // the import statement on accept.
            "autoImportCompletions": true,
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            // Inline hints the way PyCharm renders them.
            "inlayHints": {
              "variableTypes": true,
              "functionReturnTypes": true,
              "callArgumentNames": true,
              "genericTypes": false
            }
          }
        }
      }
    },
    // `ruff server`: lint + format + import sorting. A project's pyproject.toml /
    // ruff.toml wins over everything here (configurationPreference default).
    "ruff": {
      "initialization_options": {
        "settings": {
          "configurationPreference": "filesystemFirst",
          // Matches preferred_line_length / wrap_guides above.
          "lineLength": 100,
          // Default rule set (E4, E7, E9, F) plus isort-style import ordering.
          "lint": { "enable": true, "extendSelect": ["I"] },
          "fixAll": true,
          "organizeImports": true,
          "showSyntaxErrors": true,
          "codeAction": {
            // Hide the "Disable RULE for this line" quick fix; keep "Fix RULE".
            "disableRuleComment": { "enable": false },
            "fixViolation": { "enable": true }
          }
        }
      }
    }
  },
  "languages": {
    "Python": {
      // basedpyright for navigation/completion/types, ruff for lint/format.
      // "!" keeps the other Python servers off so diagnostics aren't doubled
      // (pylsp is what this file used before; ty/pyrefly/pyright are the
      // remaining built-in alternatives).
      "language_servers": ["basedpyright", "ruff", "!pylsp", "!pyright", "!ty", "!pyrefly", "..."],
      // On Cmd-S: apply ruff's safe fixes and sort imports, then format.
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        { "language_server": { "name": "ruff" } }
      ],
      // Gutter run/debug icons on `def test_*`, test classes and
      // `if __name__ == "__main__":`, like PyCharm's green triangles.
      "tasks": { "enabled": true }
    }
  },

  // ---- Running & debugging (PyCharm run configurations) ------------------
  // Shift-F10 (task::Spawn) lists Zed's built-in Python tasks plus the ones in
  // zed/tasks.json (run file with uv, pytest for file / whole suite / symbol
  // under cursor, ruff). Shift-F9 (debugger::Start) does the same for
  // zed/debug.json; the Debugpy adapter is downloaded by Zed on first use.
  // zed/keymap.json adds the macOS PyCharm keys (Ctrl-R run, Ctrl-D debug).
  "debugger": {
    "dock": "bottom",
    "stepping_granularity": "line",
    // Breakpoints survive restarts, as in PyCharm.
    "save_breakpoints": true
  },

  // ---- Git: inline blame on the current line (like `space B` in Helix) --
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": { "enabled": true, "delay_ms": 800 }
  },

  // ---- Panels -----------------------------------------------------------
  "project_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "agent": { "dock": "right" },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 14,
    // New terminals start with the project's venv activated, so `python`,
    // `pytest` and `ruff` there are the same ones basedpyright/tasks use.
    "detect_venv": {
      "on": {
        "directories": [".venv", "venv", ".env", "env"],
        "activate_script": "default"
      }
    }
  },

  // ---- Extensions: installed automatically on first launch --------------
  // Rust, Python, C/C++, JSON, YAML, Markdown are built in. These cover the
  // rest of the stack in this repo (zig/zls, Cargo.toml + pyproject.toml,
  // zellij's KDL configs, justfiles, Docker/Make in C projects).
  "auto_install_extensions": {
    "zig": true,
    "toml": true,
    "kdl": true,
    "just": true,
    "dockerfile": true,
    "make": true,
    "sql": true,
    "env": true,
    "log": true,
    "csv": true
  },

  // ---- Privacy -----------------------------------------------------------
  // No usage/crash telemetry, and no edit prediction: Zed's built-in
  // predictor streams buffer contents to Zed's servers while you type.
  "telemetry": { "diagnostics": false, "metrics": false },
  "show_edit_predictions": false
}
