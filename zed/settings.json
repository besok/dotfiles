// Zed user settings — symlinked to ~/.config/zed/settings.json by install.sh.
// Reference: https://zed.dev/docs/configuring-zed ; `zed: open default settings`
// in the command palette shows every default this file overrides.
{
  // ---- Look & feel: light One theme, same font as Alacritty/Helix -------
  "edit_predictions": {
    "provider": "none"
  },
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "cursor_blink": false,
  "relative_line_numbers": "disabled",
  "wrap_guides": [100],
  "show_wrap_guides": true,
  "preferred_line_length": 100,
  "soft_wrap": "none",
  "indent_guides": { "enabled": true },
  "show_whitespaces": "selection",
  "tab_size": 4,
  "tabs": { "file_icons": true, "git_status": true },
  "toolbar": { "breadcrumbs": true },
  // "comfortable" is the default; switch to { "custom": 1.4 } to tighten/loosen.
  "buffer_line_height": "comfortable",
  // Diff, diagnostic, cursor and search markers in the scrollbar gutter.
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "diagnostics": "all",
    "cursors": true,
    "search_results": true
  },
  // IntelliJ-style: error/warning text rendered at the end of the line.
  "diagnostics": { "inline": { "enabled": true } },
  "hover_popover_enabled": true,
  "hover_popover_delay": 300,

  // ---- IntelliJ-style workflow ------------------------------------------
  // JetBrains keybindings (Ctrl/Cmd-S, Shift-Shift search, etc.).
  "base_keymap": "JetBrains",
  // Alternative: modal editing with Helix keys (built on Zed's vim mode).
  // Flip this on and Zed behaves like hx for movement/selection while the
  // JetBrains bindings above still cover IDE actions (search, run, debug).
  // Still incomplete as of 2026: select-mode, some multi-cursor commands and
  // a few `g`/`space` menus differ from real hx. Left off until it matures.
  // "helix_mode": true,
  // Save like IntelliJ: continuously while typing (0.5s after the last
  // keystroke) *and* whenever the editor loses focus — no explicit save
  // needed. Autosave does not trigger formatters; only an explicit Cmd-S
  // runs format_on_save below.
  "autosave": { "after_delay": { "milliseconds": 500 } },
  "restore_on_startup": "last_session",
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  // JetBrains-like bracket handling: auto-insert the closing pair and let
  // typing the closer skip over it even after moving the cursor.
  "use_autoclose": true,
  "always_treat_brackets_as_autoclosed": true,
  // Double-click a hit in project search / diagnostics to open the real file.
  "double_click_in_multibuffer": "open",
  // Default toggles for the search bar.
  "search": {
    "case_sensitive": false,
    "whole_word": false,
    "regex": false,
    "include_ignored": false
  },

  // ---- Project indexing -------------------------------------------------
  // Setting this REPLACES Zed's defaults, so the VCS/OS entries are repeated
  // here. Build and cache dirs are excluded from search, the project panel and
  // the file finder (rust target/, python venvs, zig caches, node_modules).
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/target",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.pytest_cache",
    "**/zig-out",
    "**/.zig-cache",
    "**/node_modules"
  ],

  // ---- LSP / language tooling (mirrors helix/languages.toml) ------------
  "inlay_hints": { "enabled": true },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" }
      }
    },
    // Zed downloads pylsp into its own venv (python-lsp-server[all] +
    // pylsp-mypy + rope), so nothing extra is needed from install.sh. Zed also
    // points jedi and mypy at the project's .venv it detects, so third-party
    // imports resolve without further config.
    "pylsp": {
      "settings": {
        // NOTE: rope cannot be told to skip <project>/.ropeproject/ from here.
        // pylsp's settings merge (pylsp/_utils.py merge_dicts) drops every key
        // whose value is null, so `"rope": { "ropeFolder": null }` never reaches
        // rope and it falls back to its default folder. The only way to keep
        // the folder out of the repo is to not load rope at all; see
        // rope_autoimport below.
        "plugins": {
          // Linters/formatters superseded by `ruff server` below.
          "autopep8": { "enabled": false },
          "black": { "enabled": false },
          "flake8": { "enabled": false },
          "isort": { "enabled": false },
          "mccabe": { "enabled": false },
          "pycodestyle": { "enabled": false },
          "pydocstyle": { "enabled": false },
          "pyflakes": { "enabled": false },
          "pylint": { "enabled": false },
          "yapf": { "enabled": false },
          // python-lsp-ruff, if ever installed: ruff runs as its own server.
          "ruff": { "enabled": false },

          // Type checking via mypy (pyright is disabled in "languages" below).
          // live_mode re-runs mypy on every change; set "dmypy": true (and
          // "live_mode": false) on large projects if it gets slow.
          "pylsp_mypy": { "enabled": true, "live_mode": true, "report_progress": true },
          // jedi_* (completion, hover, goto, references, symbols) are on by
          // default. rope_autoimport would add "import X" quick fixes for
          // unresolved names, but it is the plugin that builds a rope Project,
          // and that always creates <project>/.ropeproject/ (plus a ~10 MB
          // autoimport.db unless "memory": true). Disabled so no folder shows
          // up in repos. To get the quick fixes back, set "enabled": true and
          // keep "memory": true, then add .ropeproject to the global gitignore.
          "rope_autoimport": {
            "enabled": false,
            "memory": true,
            "completions": { "enabled": false },
            "code_actions": { "enabled": true }
          }
        }
      }
    },
    // `ruff server`: lint + format + import sorting. A project's pyproject.toml /
    // ruff.toml wins over everything here (configurationPreference default).
    "ruff": {
      "initialization_options": {
        "settings": {
          "configurationPreference": "filesystemFirst",
          // Matches preferred_line_length / wrap_guides above.
          "lineLength": 100,
          // Default rule set (E4, E7, E9, F) plus isort-style import ordering.
          "lint": { "enable": true, "extendSelect": ["I"] },
          "fixAll": true,
          "organizeImports": true,
          "showSyntaxErrors": true,
          "codeAction": {
            // Hide the "Disable RULE for this line" quick fix; keep "Fix RULE".
            "disableRuleComment": { "enable": false },
            "fixViolation": { "enable": true }
          }
        }
      }
    }
  },
  "languages": {
    "Python": {
      // pylsp (jedi + mypy + rope) for IDE features, ruff for lint/format.
      // "!" disables Zed's default type checkers so diagnostics aren't doubled.
      "language_servers": ["pylsp", "ruff", "!basedpyright", "!pyright", "!ty", "..."],
      // On Cmd-S: apply ruff's safe fixes and sort imports, then format.
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        { "language_server": { "name": "ruff" } }
      ]
    }
  },

  // ---- Git: inline blame on the current line (like `space B` in Helix) --
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": { "enabled": true, "delay_ms": 800 }
  },

  // ---- Panels -----------------------------------------------------------
  "project_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "agent": { "dock": "right" },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 14
  },

  // ---- Extensions: installed automatically on first launch --------------
  // Rust, Python, C/C++, JSON, YAML, Markdown are built in. These cover the
  // rest of the stack in this repo (zig/zls, Cargo.toml + pyproject.toml,
  // zellij's KDL configs, justfiles, Docker/Make in C projects).
  "auto_install_extensions": {
    "zig": true,
    "toml": true,
    "kdl": true,
    "just": true,
    "dockerfile": true,
    "make": true,
    "sql": true,
    "env": true,
    "log": true,
    "csv": true
  },

  // ---- Privacy -----------------------------------------------------------
  // No usage/crash telemetry, and no edit prediction: Zed's built-in
  // predictor streams buffer contents to Zed's servers while you type.
  "telemetry": { "diagnostics": false, "metrics": false },
  "show_edit_predictions": false
}
